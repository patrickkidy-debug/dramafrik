# ── Base ──────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"
# Adresse publique du site (https://... en production : Wave et CinetPay en ont besoin)
APP_URL="http://localhost:3000"
# Clé secrète des sessions : 32 caractères minimum, gardez-la secrète
AUTH_SECRET="remplacez-par-une-longue-chaine-aleatoire-de-32-caracteres"

# Indicatif ajouté aux numéros saisis sans "+" (221 Sénégal, 225 Côte d'Ivoire, 223 Mali, 226 Burkina...)
DEFAULT_COUNTRY_CODE="221"
CURRENCY="XOF"
MIN_PRICE_XOF=300

# ── Paiement ──────────────────────────────────────────────────────────
# "simulation" = tester sans vrai paiement. "live" = vrais paiements avec les clés ci-dessous.
PAYMENT_MODE="simulation"

# GeniusPay → https://geniuspay.ci/dashboard/settings?tab=api  (Wave, Orange Money, MTN, Moov, carte)
# Clés sandbox = pk_sandbox_… / sk_sandbox_…   Clés réelles = pk_live_… / sk_live_…
GENIUSPAY_PUBLIC_KEY=""
GENIUSPAY_SECRET_KEY=""

# Wave Business → https://business.wave.com  (Développeurs → Clés API, droit "Checkout API")
WAVE_API_KEY=""

# CinetPay → https://cinetpay.com  (Orange Money, MTN, Moov, Free, Wave, carte bancaire)
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_CHANNELS="ALL"

# ── Vidéos (Bunny Stream → https://bunny.net/stream) ──────────────────
BUNNY_LIBRARY_ID=""
# Clé "Token Authentication" de la bibliothèque : empêche le partage des liens vidéo
BUNNY_TOKEN_KEY=""

# ── Compte administrateur créé par "npm run setup" ────────────────────
ADMIN_NAME="Admin"
ADMIN_PHONE="+221770000000"
ADMIN_PASSWORD="changez-ce-mot-de-passe"
