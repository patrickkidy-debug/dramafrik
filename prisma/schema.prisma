generator client {
  provider = "prisma-client-js"
}

// SQLite pour démarrer. En production, vous pouvez passer à "postgresql".
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  name         String
  phone        String     @unique
  passwordHash String
  isAdmin      Boolean    @default(false)
  createdAt    DateTime   @default(now())
  orders       Order[]
  purchases    Purchase[]
}

model Series {
  id           String     @id @default(cuid())
  slug         String     @unique
  title        String
  tagline      String     @default("")
  synopsis     String     @default("")
  coverUrl     String     @default("")
  priceXof     Int
  // Les N premiers épisodes sont gratuits (pour accrocher le public)
  freeEpisodes Int        @default(1)
  published    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  episodes     Episode[]
  orders       Order[]
  purchases    Purchase[]
}

model Episode {
  id          String @id @default(cuid())
  seriesId    String
  series      Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  number      Int
  title       String
  // ID de la vidéo dans Bunny Stream (recommandé)…
  videoId     String @default("")
  // …ou un lien direct vers un fichier .mp4 (pour tester)
  videoUrl    String @default("")
  durationSec Int    @default(0)

  @@unique([seriesId, number])
}

model Order {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  seriesId    String
  series      Series    @relation(fields: [seriesId], references: [id])
  amountXof   Int
  provider    String // "wave" | "cinetpay" | "simulation"
  status      String    @default("PENDING") // PENDING | PAID | FAILED
  providerRef String?
  createdAt   DateTime  @default(now())
  paidAt      DateTime?

  @@index([status])
}

model Purchase {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  seriesId  String
  series    Series   @relation(fields: [seriesId], references: [id])
  orderId   String?
  createdAt DateTime @default(now())

  @@unique([userId, seriesId])
}
